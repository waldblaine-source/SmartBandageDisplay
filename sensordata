import serial
import time


SERIAL_PORT = "COM3"
BAUD_RATE = 115200

ser = None


def connect_sensor():
    global ser

    try:
        ser = serial.Serial(
            port=SERIAL_PORT,
            baudrate=BAUD_RATE,
            timeout=1
        )

        time.sleep(2)
        print (f"Connected to sensor on {SERIAL_PORT}")
        return True
  


  
